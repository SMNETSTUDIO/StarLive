{
  "name": "starlive",
  "version": "0.1.0",
  "private": true,
  "description": "StarLive 星播平台 - 直播互动平台",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "pnpm -r --sort run build",
    "dev:server": "pnpm --filter @starlive/server run start:dev",
    "dev:web": "pnpm --filter @starlive/web run dev",
    "dev:worker": "pnpm --filter @starlive/worker run dev"
  }
}
