# ── 应用（前后端一体化，同一端口） ────────────────────
APP_BASE_URL=http://localhost:3000
NODE_ENV=development
PORT=3000
# 前端构建产物目录（留空默认 apps/web/dist）
# WEB_DIST=
# 单端口部署时 /hls 的转发目标（MediaMTX HLS）
# HLS_PROXY_TARGET=http://localhost:8888

# ── Redis ────────────────────────────────────────────
# 自托管示例：redis://:password@localhost:6379
# Upstash 示例：redis://default:TOKEN@xxx.upstash.io:6379
REDIS_URL=redis://localhost:6379

# ── Cookie（前端与 API 跨站部署时设 none / true）──────
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# ── 前端（写在 apps/web/.env）────────────────────────
# 外部 API 地址，留空走同源 Vite 代理
# VITE_API_BASE=https://api.example.com

# ── 认证 ────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret
SESSION_TTL=604800

# 可选 OAuth（通用 OAuth2 / LinuxDO）；配置后登录页/首页自动出现入口
# 按钮显示名（如 LinuxDO），默认 OAuth
OAUTH_PROVIDER_NAME=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# 回调地址填 {APP_BASE_URL}/api/auth/oauth-callback
OAUTH_REDIRECT_URI=

# ── 超级管理员 ───────────────────────────────────────
# 首次部署无需配置：打开网页会引导创建管理员账号密码。
# 如需通过环境变量强制指定超管，可填用户 ID（逗号分隔）。
ADMIN_USER_IDS=

# ── 推流 / 录播 ─────────────────────────────────────
STREAM_PROVIDER=selfhosted
MEDIAMTX_API=http://mediamtx:9997
MEDIAMTX_AUTH_HOOK=http://server:3000/api/stream/hook

# 可选 Mux Provider
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

FFMPEG_PATH=ffmpeg
RECORDING_DIR=./recordings

# ── 支付网关（多网关兼容，按需填写） ─────────────────
# mock 沙箱网关：可无条件入账，仅限联调。
# 非生产环境默认开启；生产环境（NODE_ENV=production）默认关闭，
# 如需在生产强制开启需显式设 true（不推荐）。
PAYMENT_MOCK_ENABLED=

# 易支付 / 彩虹易支付
EPAY_PID=
EPAY_KEY=
EPAY_GATEWAY=

# 支付宝（RSA2 密钥模式；异步通知地址 {APP_BASE_URL}/api/payment/callback/alipay）
ALIPAY_APP_ID=
# 应用私钥 / 支付宝公钥可直接粘贴开放平台的无头尾 base64
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
# 网关地址（默认生产网关，沙箱填 https://openapi-sandbox.dl.alipaydev.com/gateway.do）
ALIPAY_GATEWAY=

# 微信支付（APIv3 Native 扫码；回调地址 {APP_BASE_URL}/api/payment/callback/wechat）
WECHAT_APP_ID=
WECHAT_MCH_ID=
# APIv3 密钥（32 字符，用于回调解密）
WECHAT_API_KEY=
# 商户 API 证书序列号 + 商户 API 私钥（可粘贴无头尾 base64）
WECHAT_SERIAL_NO=
WECHAT_PRIVATE_KEY=

# Stripe（Checkout + Webhook；Webhook 事件选 checkout.session.completed，
# 地址 {APP_BASE_URL}/api/payment/callback/stripe）
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# 计费货币（订单金额按该货币直接计费，默认 usd）
STRIPE_CURRENCY=usd

# 提现分发
LPAY_CLIENT_ID=
LPAY_CLIENT_SECRET=
LPAY_GATEWAY=
