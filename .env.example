# ── 应用 ─────────────────────────────────────────────
APP_BASE_URL=http://localhost:3000
NODE_ENV=development
PORT=4000

# ── Redis ────────────────────────────────────────────
# 自托管示例：redis://:password@localhost:6379
# Upstash 示例：redis://default:TOKEN@xxx.upstash.io:6379
REDIS_URL=redis://localhost:6379

# ── 认证 ────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret
SESSION_TTL=604800

# 可选 OAuth（通用 OAuth2 / LinuxDO）
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=

# ── 超级管理员（逗号分隔用户 ID） ────────────────────
ADMIN_USER_IDS=

# ── 推流 / 录播 ─────────────────────────────────────
STREAM_PROVIDER=selfhosted
MEDIAMTX_API=http://mediamtx:9997
MEDIAMTX_AUTH_HOOK=http://server:4000/api/stream/hook

# 可选 Mux Provider
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

FFMPEG_PATH=ffmpeg
RECORDING_DIR=./recordings

# ── 支付网关（多网关兼容，按需填写） ─────────────────
# 易支付 / 彩虹易支付
EPAY_PID=
EPAY_KEY=
EPAY_GATEWAY=

# 支付宝
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=

# 微信支付
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# 提现分发
LPAY_CLIENT_ID=
LPAY_CLIENT_SECRET=
LPAY_GATEWAY=
